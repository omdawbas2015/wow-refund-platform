# ----- Database -----
# Local dev uses SQLite. For production, use PostgreSQL (Neon, Supabase, etc.)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"

# ----- Auth.js -----
# Generate with: openssl rand -hex 32
AUTH_SECRET="development-secret-change-me-in-production"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ----- Power Automate -----
# Leave blank for local dev (emails will be logged to console instead of sent).
POWER_AUTOMATE_WEBHOOK_URL=""
POWER_AUTOMATE_SIGNING_SECRET=""

# Inbound webhook (Power Automate → our API when customers/stores/managers reply)
POWER_AUTOMATE_INBOUND_SECRET=""

# ----- Redis (Upstash) — optional in dev -----
REDIS_URL=""
REDIS_TOKEN=""

# ----- Observability -----
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ----- Feature flags -----
NEXT_PUBLIC_APP_NAME="WOW Refund"
NEXT_PUBLIC_APP_VERSION="0.1.0"

# ----- OTP / Security -----
OTP_TTL_MINUTES="15"
PASSWORD_MIN_LENGTH="8"
LOGIN_LOCKOUT_ATTEMPTS="5"
LOGIN_LOCKOUT_WINDOW_MINUTES="15"
LOGIN_LOCKOUT_DURATION_MINUTES="30"

# ----- Exchange Rates -----
# Free public API: https://exchangerate.host (no key needed for basic use)
EXCHANGE_RATE_API_URL="https://api.exchangerate.host"
EXCHANGE_RATE_BASE_CURRENCY="KWD"
